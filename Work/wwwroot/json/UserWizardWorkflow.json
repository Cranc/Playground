{
  "name": "UserWizard",
  "startStep": "Start",
  "steps": [
    {
      "name": "Start",
      "component": "StartPage",
      "transitions": {
        "SelectUser": "SelectUser",
        "CreateUser": "CreateUser"
      }
    },
    {
      "name": "SelectUser",
      "component": "SelectUserPage",
      "next": "ConfigureRoles"
    },
    {
      "name": "CreateUser",
      "before": "CreateUser.InitAttempts",
      "execute": "CreateUserStep",
      "component": "CreateUserPage",
      "after": "CreateUser.StampLastRun",
      "next": "ConfigureRoles"
    },
    {
      "name": "ConfigureRoles",
      "component": "ConfigureRolesPage",
      "transitions": {
        "Summary": "Summary",
        "Advanced": "Advanced"
      }
    },
    {
      "name": "Summary",
      "component": "SummaryPage",
      "transitions": {
        "Finish": "Finish",
        "Advanced": "Advanced"
      }
    },
    {
      "name": "Advanced",
      "component": "AdvancedPage",
      "transitions": {
        "Finish": "Finish",
        "Summary": "Summary"
      }
    },
    {
      "name": "Finish",
      "execute": "FinishStep",
      "retry": 3,
      "onException": "Finish.HandleError"
    }
  ]
}