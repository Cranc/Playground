@using Work.Components.TicketPlanner.Models
@using DevExpress.Blazor
@inject IJSRuntime JS

<div id="member-@Member.Id" class="member-lane">
	<div class="member-header-row">
		<div class="member-avatar" style="background:@Member.Color">@GetInitials(Member.DisplayName)</div>
		<div class="member-main">
			<div class="member-title">
				<span class="member-name">@Member.DisplayName</span>
				<span class="member-role">@Member.Role</span>
			</div>
			<div class="capacity-row">
				<div class="progress-wrap">
					<DxProgressBar Value="@Percent" Min="0" Max="100" ShowValue="false" ShowIcon="false" ShowLabel="false" CssClass="member-progress" Size="Auto" SizeMode="SizeMode.Large" SetSuccessStatusOnComplete="false"/>
				</div>
				<div class="capacity-text">@AssignedHours / @Member.MonthlyCapacityHours<h6 class="visually-hidden">hours</h6></div>
			</div>
		</div>
	</div>

	<div class="assigned-tickets">
		@if (AssignedTickets != null && AssignedTickets.Any())
		{
			<div class="assigned-ticket-row">
			@foreach (var at in AssignedTickets)
			{
				<div class="assigned-ticket" draggable="true" ondragstart="event.dataTransfer.setData('text/plain', JSON.stringify({ticketId:'@at.Id', sourceMemberId:'@Member.Id'}))">
					<span class="ticket-key">@at.Key</span>
					<span class="ticket-type badge @GetTypeClass(at.Type)">@at.Type</span>
					<span class="ticket-hours">@($"{at.EstimatedHours}h")</span>
					<button class="btn-unassign" @onclick="() => OnUnassign.InvokeAsync(at.Id)" type="button" aria-label="Remove">×</button>
				</div>
			}
			</div>
		}
		else
		{
			<div class="lane-empty">Drag tickets here to assign</div>
		}
	</div>
</div>

@code {
	[Parameter]
	public PlannerMember Member { get; set; } = new();

	[Parameter]
	public IEnumerable<PlannerTicket> AssignedTickets { get; set; } = Enumerable.Empty<PlannerTicket>();

	[Parameter]
	public decimal AssignedHours { get; set; }

	[Parameter]
	public int WarningThreshold { get; set; } = 80;

	[Parameter]
	public int DangerThreshold { get; set; } = 100;

	[Parameter]
	public EventCallback<string> OnUnassign { get; set; }

	[Parameter]
	public object? DotNetRef { get; set; }

	int Percent => Member.MonthlyCapacityHours <= 0 ? 0 : (int)Math.Round((double)(AssignedHours / Member.MonthlyCapacityHours) * 100.0);

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		// Register this lane as a drop zone when the component is rendered
		if (DotNetRef != null)
		{
			await JS.InvokeVoidAsync("ticketPlanner.registerDropZone", $"member-{Member.Id}", DotNetRef, Member.Id);
		}
	}

	string GetInitials(string name)
	{
		if (string.IsNullOrWhiteSpace(name)) return "";
		var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
		if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
		return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpperInvariant();
	}

	string GetTypeClass(string type) => type.ToLowerInvariant() switch
	{
		"feature" => "type-feature",
		"bug" => "type-bug",
		"task" => "type-task",
		"spike" => "type-spike",
		_ => "type-default"
	};
}
