@using Work.Components.TicketPlanner.Models
@using Microsoft.AspNetCore.Components

@if (IsOpen)
{
<div class="amd-backdrop">
	<div class="amd-dialog">
		<div class="amd-header">
			<h4>Add Team Member</h4>
			<button class="amd-close" @onclick="Cancel">×</button>
		</div>
		<div class="amd-body">
			<label class="label">NAME</label>
			<input class="form-control" placeholder="Full name" @bind="Name" />

			<label class="label mt-2">ROLE</label>
			<input class="form-control" placeholder="e.g. Backend Dev" @bind="Role" />

			<label class="label mt-2">SPRINT CAPACITY (HOURS)</label>
			<input class="form-control" type="number" @bind="Capacity" />

			<label class="label mt-2">COLOR</label>
			<div class="color-palette">
				@foreach (var c in Colors)
				{
					<button type="button" class="color-swatch @(SelectedColor == c ? "selected" : "")" style="background:@c" @onclick="(() => SelectColor(c))"></button>
				}
			</div>

			<div class="member-preview">
				<div class="preview-avatar" style="background:@SelectedColor">@GetInitials(Name)</div>
				<div class="preview-info">
					<div class="preview-name">@((string.IsNullOrWhiteSpace(Name)) ? "Full Name" : Name)</div>
					<div class="preview-sub">@((string.IsNullOrWhiteSpace(Role)) ? $"Role - {Capacity}h / sprint" : $"{Role} - {Capacity}h / sprint")</div>
				</div>
			</div>
		</div>
		<div class="amd-footer">
			<button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
			<button class="btn btn-success" @onclick="Add" disabled="@string.IsNullOrWhiteSpace(Name)">Add Member</button>
		</div>
	</div>
</div>
}

@code {
	[Parameter]
	public bool IsOpen { get; set; }

	[Parameter]
	public EventCallback<bool> IsOpenChanged { get; set; }

	[Parameter]
	public EventCallback<PlannerMember> OnAdd { get; set; }

	string Name { get; set; } = string.Empty;
	string Role { get; set; } = string.Empty;
	decimal Capacity { get; set; } = 40;
	string SelectedColor { get; set; } = "#00D3A7";

	readonly string[] Colors = new[] { "#00D3A7", "#FF9AA2", "#FFB572", "#6B5CFF", "#FF5C7A", "#FFD66B", "#00B9C0", "#FF7A7A" };

	void SelectColor(string c) => SelectedColor = c;

	string GetInitials(string name)
	{
		if (string.IsNullOrWhiteSpace(name)) return "??";
		var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
		if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
		return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpperInvariant();
	}

	async Task Add()
	{
		var member = new PlannerMember { DisplayName = Name, Role = Role, MonthlyCapacityHours = Capacity, Color = SelectedColor };
		await OnAdd.InvokeAsync(member);
		await Close();
	}

	async Task Cancel()
	{
		await Close();
	}

	async Task Close()
	{
		IsOpen = false;
		await IsOpenChanged.InvokeAsync(IsOpen);
		// reset form
		Name = string.Empty; Role = string.Empty; Capacity = 40; SelectedColor = Colors[0];
	}
}
