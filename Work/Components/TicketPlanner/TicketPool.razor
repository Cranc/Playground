@using Work.Components.TicketPlanner.Models
@using Work.Components.TicketPlanner.Services
@rendermode InteractiveServer
@inject ITicketService TicketService
@inject IJSRuntime JS

<div class="ticket-pool">
	<div class="ticket-pool-sidebar">
		<DxTextBox @bind-Text="SearchText" Placeholder="Search tickets..." CssClass="search-box" NullText="Enter Search text" />
		<div class="filters">
			<div class="filter-item">
				<DxComboBox Data="AvailableTypes" @bind-Value="SelectedType" CssClass="filter-box" NullText="Types" />
				@if (!string.IsNullOrEmpty(SelectedType))
				{
					<button type="button" class="btn-clear" title="Clear type filter" @onclick="() => { SelectedType = null; }">×</button>
				}
			</div>
			<div class="filter-item">
				<DxComboBox Data="AvailablePriorities" @bind-Value="SelectedPriority" CssClass="filter-box" NullText="Prioryties" />
				@if (!string.IsNullOrEmpty(SelectedPriority))
				{
					<button type="button" class="btn-clear" title="Clear priority filter" @onclick="() => { SelectedPriority = null; }">×</button>
				}
			</div>
			<div class="filter-actions">
				<button type="button" class="btn-clear-all" @onclick="ClearFilters">Clear</button>
			</div>
		</div>
		<div class="ticket-list">
			@foreach (var t in FilteredTickets)
			{
				<TicketCard Ticket="t" OnDragStart="OnTicketDragStart" />
			}
		</div>
	</div>
	<div class="ticket-pool-main">
		<div class="team-capacity-header">
			<div>
				<h3>TEAM CAPACITY</h3>
				<div class="team-capacity-sub">@(_members.Count) members · @GetTotalAssignedHours()h total sprint capacity</div>
			</div>
			<div class="add-member">
				<DxButton class="btn btn-success btn-sm" @onclick="ShowAddMember">+ Add Member</DxButton>
			</div>
		</div>

		<AddMemberDialog @bind-IsOpen="_showAddMember" OnAdd="HandleDialogAddMember" />

		<div class="member-lanes">
			@foreach (var m in _members)
			{
				<MemberLane Member="m" AssignedTickets="GetAssignedTickets(m.Id)" AssignedHours="GetAssignedHours(m.Id)" OnUnassign="(ticketId) => HandleUnassign(m.Id, ticketId)" />
			}
		</div>
	</div>
</div>

@code {
	[Parameter]
	public IEnumerable<PlannerTicket>? Tickets { get; set; }

	[Parameter]
	public EventCallback<string> OnTicketDragStart { get; set; }

	string SearchText { get; set; } = string.Empty;
	string? SelectedType { get; set; }
	string? SelectedPriority { get; set; }

	List<PlannerTicket> _tickets = new();
	List<PlannerTicket> _allTicketsSnapshot = new();

	List<PlannerMember> _members = new();
	List<PlannerAssignment> _assignments = new();

	// Add member dialog state
	bool _showAddMember = false;

	private DotNetObjectReference<TicketPool>? _dotNetRef;

	IEnumerable<PlannerTicket> FilteredTickets => _tickets
			.Where(t => string.IsNullOrWhiteSpace(SearchText) || t.Title.Contains(SearchText, StringComparison.OrdinalIgnoreCase) || t.Key.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
			.Where(t => string.IsNullOrEmpty(SelectedType) || t.Type == SelectedType)
			.Where(t => string.IsNullOrEmpty(SelectedPriority) || t.Priority == SelectedPriority);

	IEnumerable<string> AvailableTypes => _tickets
					.Select(t => t.Type)
					.Where(t => !string.IsNullOrWhiteSpace(t))
					.Distinct();

	IEnumerable<string> AvailablePriorities => _tickets
					.Select(t => t.Priority)
					.Where(p => !string.IsNullOrWhiteSpace(p))
					.Distinct();

	protected override async Task OnInitializedAsync()
	{
		if (Tickets != null)
		{
			_tickets = Tickets.ToList();
			_allTicketsSnapshot = _tickets.Select(t => new PlannerTicket { Id = t.Id, Key = t.Key, Title = t.Title, Type = t.Type, Priority = t.Priority, Status = t.Status, EstimatedHours = t.EstimatedHours }).ToList();
		}
		else
		{
			var data = await TicketService.GetTicketsAsync();
			_tickets = data.ToList();
			// keep snapshot for assigned ticket lookup after removal from pool
			_allTicketsSnapshot = _tickets.Select(t => new PlannerTicket { Id = t.Id, Key = t.Key, Title = t.Title, Type = t.Type, Priority = t.Priority, Status = t.Status, EstimatedHours = t.EstimatedHours }).ToList();
		}

		// initial members
		_members = new List<PlannerMember>
				{
						new PlannerMember { Id = "m1", DisplayName = "Alex Kim", Role = "Frontend Dev", MonthlyCapacityHours = 40, Color = "#00D3A7" },
						new PlannerMember { Id = "m2", DisplayName = "Sara Müller", Role = "UX Designer", MonthlyCapacityHours = 40, Color = "#6B5CFF" },
						new PlannerMember { Id = "m3", DisplayName = "Jordan Lee", Role = "Backend Dev", MonthlyCapacityHours = 32, Color = "#FF5C7A" }
				};
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			// Create a DotNetObjectReference for this component instance (required for server-side interactive JS interop)
			_dotNetRef = DotNetObjectReference.Create(this);
			foreach (var m in _members)
			{
				await JS.InvokeVoidAsync("ticketPlanner.registerDropZone", $"member-{m.Id}", _dotNetRef, m.Id);
			}
		}
	}

	[JSInvokable]
	public Task OnDropFromJs(string memberId, string ticketId, string? sourceMemberId = null)
	{
		// If sourceMemberId provided, it's a move between lanes
		if (!string.IsNullOrEmpty(sourceMemberId) && sourceMemberId != memberId)
		{
			HandleMoveAssignment(sourceMemberId, memberId, ticketId);
			return Task.CompletedTask;
		}

		// Otherwise, it's a new assignment from pool
		var ticket = _allTicketsSnapshot.FirstOrDefault(t => t.Id == ticketId);
		if (ticket != null)
		{
			_assignments.Add(new PlannerAssignment { MemberId = memberId, TicketId = ticketId, PlannedHours = ticket.EstimatedHours });
			// remove from pool if present
			var inPool = _tickets.FirstOrDefault(t => t.Id == ticketId);
			if (inPool != null) _tickets.Remove(inPool);
			StateHasChanged();
		}
		return Task.CompletedTask;
	}

	IEnumerable<PlannerTicket> GetAssignedTickets(string memberId)
	{
		var ids = _assignments.Where(a => a.MemberId == memberId).Select(a => a.TicketId).ToHashSet();
		return _allTicketsSnapshot.Where(t => ids.Contains(t.Id));
	}

	void HandleUnassign(string memberId, string ticketId)
	{
		// Remove assignment
		var assignment = _assignments.FirstOrDefault(a => a.MemberId == memberId && a.TicketId == ticketId);
		if (assignment != null)
		{
			_assignments.Remove(assignment);
		}
		// Add ticket back to pool
		var ticket = _allTicketsSnapshot.FirstOrDefault(t => t.Id == ticketId);
		if (ticket != null && !_tickets.Any(t => t.Id == ticketId))
		{
			_tickets.Add(ticket);
		}
		StateHasChanged();
	}

	void HandleMoveAssignment(string sourceMemberId, string targetMemberId, string ticketId)
	{
		// Remove from source
		var sourceAssignment = _assignments.FirstOrDefault(a => a.MemberId == sourceMemberId && a.TicketId == ticketId);
		if (sourceAssignment != null)
		{
			_assignments.Remove(sourceAssignment);
		}
		// Add to target
		var ticket = _allTicketsSnapshot.FirstOrDefault(t => t.Id == ticketId);
		if (ticket != null)
		{
			_assignments.Add(new PlannerAssignment { MemberId = targetMemberId, TicketId = ticketId, PlannedHours = ticket.EstimatedHours });
		}
		StateHasChanged();
	}

	void Testclick()
	{
		Console.WriteLine("Test click");
	}

	void ShowAddMember()
	{
		_showAddMember = true;
	}
	void HideAddMember() { _showAddMember = false; }

	void ClearFilters()
	{
		SelectedType = null;
		SelectedPriority = null;
		SearchText = string.Empty;
	}

	async Task HandleDialogAddMember(PlannerMember member)
	{
		if (member == null || string.IsNullOrWhiteSpace(member.DisplayName)) return;
		var id = "m" + (_members.Count + 1).ToString();
		member.Id = id;
		_members.Add(member);
		_showAddMember = false;
		// register new drop zone for the added member (server interactive scenario)
		if (_dotNetRef != null)
		{
			await JS.InvokeVoidAsync("ticketPlanner.registerDropZone", $"member-{member.Id}", _dotNetRef, member.Id);
		}
		StateHasChanged();
	}

	decimal GetAssignedHours(string memberId) => _assignments.Where(a => a.MemberId == memberId).Sum(a => a.PlannedHours);

	int GetCapacityPercentInt(PlannerMember m)
	{
		if (m.MonthlyCapacityHours <= 0) return 0;
		var p = (double)(GetAssignedHours(m.Id) / m.MonthlyCapacityHours) * 100.0;
		if (p < 0) p = 0; if (p > 100) p = 100;
		return (int)Math.Round(p);
	}

	public ValueTask DisposeAsync()
	{
		_dotNetRef?.Dispose();
		return ValueTask.CompletedTask;
	}

	string GetCapacityPercent(PlannerMember m) => GetCapacityPercentInt(m) + "%";

	string GetInitials(string name)
	{
		if (string.IsNullOrWhiteSpace(name)) return "";
		var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
		if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
		return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpperInvariant();
	}

	int GetTotalAssignedHours() => (int)_assignments.Sum(a => a.PlannedHours);

	string GetTypeClass(string type) => type.ToLowerInvariant() switch
	{
		"feature" => "type-feature",
		"bug" => "type-bug",
		"task" => "type-task",
		"spike" => "type-spike",
		_ => "type-default"
	};

	string GetPriorityClass(string p) => p.ToLowerInvariant() switch
	{
		"low" => "priority-low",
		"medium" => "priority-medium",
		"high" => "priority-high",
		"critical" => "priority-critical",
		_ => "priority-default"
	};
}
