<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazor.LocalStorage" Version="10.0.0" />
    <PackageReference Include="DevExpress.Blazor" Version="26.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TicketPlanner\TicketPlanner.csproj" />
    <ProjectReference Include="..\WorkflowEngine\WorkflowEngine.csproj" />
    <ProjectReference Include="..\WorkflowEngine.Blazor\WorkflowEngine.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\json\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
