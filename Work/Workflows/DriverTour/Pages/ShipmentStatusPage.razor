@inherits WorkflowEngine.Blazor.Components.WorkflowStepComponent
@using DevExpress.Blazor
@using Work.Workflows.DriverTour
@using WorkflowEngine.Catalog
@attribute [WorkflowBlock(DisplayName = "Sendungsstatus erfassen", Category = "Fahrer-Tour", Description = "Erfasst den Bearbeitungsstatus einer Einzelsendung.")]
@attribute [ConsumesContext("Tour", typeof(Tour))]
@attribute [ConsumesContext("Tour.CurrentStopIndex", typeof(int))]
@attribute [ConsumesContext("Tour.CurrentShipmentId", typeof(string))]
@attribute [ProducesContext("Shipment.PendingStatus", typeof(ShipmentStatus))]
@attribute [Outcome("Signature", DisplayName = "Unterschrift erforderlich")]
@attribute [Outcome("CompleteShipment", DisplayName = "Sendung abschließen")]

@if (_ready)
{
	<div class="card p-3">
		<h4>Sendung bearbeiten</h4>
		<p><strong>@_shipment!.TrackingNumber</strong> – @_shipment.Description<br />Empfänger: @_shipment.Recipient</p>

		<div class="mb-2">
			<label class="form-label">Bearbeitungsstatus</label>
			<DxComboBox Data="ShipmentStatusInfo.Options" TextFieldName="Label" @bind-Value="_selectedOption" />
		</div>

		<div class="d-flex gap-2 mt-3">
			<DxButton CssClass="btn btn-primary" Click="ContinueAsync" Enabled="@(!_advancing && _selectedOption is not null)">Weiter</DxButton>
			<DxButton CssClass="btn btn-light" Click="GoBackAsync" Enabled="@(!_advancing)">Zurück</DxButton>
		</div>
	</div>
}

@code {
	private Tour? _tour;
	private Shipment? _shipment;
	private ShipmentStatusInfo.Option? _selectedOption;
	private bool _ready;
	private bool _advancing;

	protected override void OnParametersSet()
	{
		// Kann kurz nach dem Verlassen dieses Schritts erneut aufgerufen werden, während
		// "Tour.CurrentShipmentId" vom Folge-Schritt bereits entfernt wurde. Dann nichts rendern.
		_ready = false;
		if (_advancing)
		{
			return;
		}

		if (!Context.TryGet<Tour>("Tour", out _tour) || _tour is null
			|| !Context.TryGet<int>("Tour.CurrentStopIndex", out var stopIndex)
			|| !Context.TryGet<string>("Tour.CurrentShipmentId", out var shipmentId) || shipmentId is null)
		{
			return;
		}

		var stop = _tour.Stops[stopIndex];
		_shipment = stop.Shipments.FirstOrDefault(s => s.Id == shipmentId);
		_ready = _shipment is not null;
	}

	private Task ContinueAsync()
	{
		if (_advancing || _selectedOption is null)
		{
			return Task.CompletedTask;
		}

		_advancing = true;
		Context.Set("Shipment.PendingStatus", _selectedOption.Status);

		return _selectedOption.RequiresSignature
			? AdvanceViaAsync("Signature")
			: AdvanceViaAsync("CompleteShipment");
	}
}
