@inherits WorkflowEngine.Blazor.Components.WorkflowStepComponent
@using DevExpress.Blazor
@using Work.Workflows.DriverTour
@using WorkflowEngine.Catalog
@attribute [WorkflowBlock(DisplayName = "Sammelstatus erfassen", Category = "Fahrer-Tour", Description = "Erfasst den gemeinsamen Bearbeitungsstatus für alle Sendungen eines Stopps.")]
@attribute [ConsumesContext("Tour", typeof(Tour))]
@attribute [ConsumesContext("Tour.CurrentStopIndex", typeof(int))]
@attribute [ProducesContext("Stop.BulkStatus", typeof(ShipmentStatus))]
@attribute [ProducesContext("Stop.BulkSignature", typeof(string))]

<div class="card p-3">
	<h4>Stop-Abschluss – @_stop.Name</h4>
	<p>Alle @_stop.Shipments.Count Sendungen dieses Stopps werden gemeinsam mit demselben Status abgeschlossen.</p>

	<div class="mb-2">
		<label class="form-label">Bearbeitungsstatus für alle Sendungen</label>
		<DxComboBox Data="ShipmentStatusInfo.Options" TextFieldName="Label" @bind-Value="_selectedOption" />
	</div>

	@if (_selectedOption is { RequiresSignature: true })
	{
		<div class="mb-2">
			<DxTextBox @bind-Text="_signatureName" NullText="Name des Unterzeichners" />
		</div>
	}

	<div class="d-flex gap-2 mt-3">
		<DxButton CssClass="btn btn-primary" Click="CompleteAsync" Enabled="@CanComplete">Alle Sendungen abschließen</DxButton>
		<DxButton CssClass="btn btn-light" Click="GoBackAsync">Zurück</DxButton>
	</div>
</div>

@code {
	private Tour _tour = null!;
	private Stop _stop = null!;
	private ShipmentStatusInfo.Option? _selectedOption;
	private string? _signatureName;

	private bool CanComplete =>
		_selectedOption is not null && (!_selectedOption.RequiresSignature || !string.IsNullOrWhiteSpace(_signatureName));

	protected override void OnParametersSet()
	{
		_tour = Context.Get<Tour>("Tour");
		var stopIndex = Context.Get<int>("Tour.CurrentStopIndex");
		_stop = _tour.Stops[stopIndex];
	}

	private Task CompleteAsync()
	{
		if (_selectedOption is null)
		{
			return Task.CompletedTask;
		}

		Context.Set("Stop.BulkStatus", _selectedOption.Status);
		Context.Set("Stop.BulkSignature", _signatureName);
		return AdvanceAsync();
	}
}
