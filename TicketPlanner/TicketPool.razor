@using System.Text.Json
@rendermode InteractiveServer
@inject ITicketService TicketService
@inject IJSRuntime JS
@inject ITicketPlanStorageService PlanStorage

@* Main planner surface for filtering tickets, assigning them to team members, and persisting plan state. *@
<script src="@JavaScriptConstants.Scripts.TicketPlanner"></script>

<div class="ticket-pool">
	<div class="ticket-pool-sidebar">
		<DxTextBox @bind-Text="SearchText" Placeholder="Search tickets..." CssClass="search-box" NullText="Enter Search text" />
		<div class="filters">
			<div class="filter-item">
				<DxComboBox Data="AvailableTypes" @bind-Value="SelectedType" CssClass="filter-box" NullText="Types" />
				@if (!string.IsNullOrEmpty(SelectedType))
				{
					<button type="button" class="btn-clear" title="Clear type filter" @onclick="() => { SelectedType = null; }">×</button>
				}
			</div>
			<div class="filter-item">
				<DxComboBox Data="AvailablePriorities" @bind-Value="SelectedPriority" CssClass="filter-box" NullText="Prioryties" />
				@if (!string.IsNullOrEmpty(SelectedPriority))
				{
					<button type="button" class="btn-clear" title="Clear priority filter" @onclick="() => { SelectedPriority = null; }">×</button>
				}
			</div>
			<div class="filter-actions">
				<button type="button" class="btn-clear-all" @onclick="ClearFilters">Clear</button>
			</div>
		</div>
		<div class="ticket-list">
			@foreach (var t in FilteredTickets)
			{
				<TicketCard Ticket="t" OnDragStart="OnTicketDragStart" />
			}
		</div>
	</div>
	<div class="ticket-pool-main">
		<div class="team-capacity-header">
			<div>
				<h3>TEAM CAPACITY</h3>
				<div class="team-capacity-sub">@(_members.Count) members · @GetTotalAssignedHours()h total sprint capacity</div>
			</div>
			<div class="add-member">
				<DxButton class="btn btn-success btn-sm" @onclick="ShowAddMember">+ Add Member</DxButton>
				<SaveLoadControls OnSave="SaveStateAsync" OnExport="ExportStateAsync" OnFileSelected="ImportFileAsync" />
			</div>
		</div>

		<AddMemberDialog @bind-IsOpen="_showAddMember" OnAdd="HandleDialogAddMember" />

		<div class="member-lanes">
			@foreach (var m in _members)
			{
				<MemberLane Member="m" AssignedTickets="GetAssignedTickets(m.Id)" AssignedHours="GetAssignedHours(m.Id)" OnUnassign="(ticketId) => HandleUnassign(m.Id, ticketId)" DotNetRef="_dotNetRef" />
			}
		</div>
	</div>
</div>

@code {
	/// <summary>
	/// Optional ticket source supplied by the parent. If omitted, tickets are loaded through <see cref="ITicketService"/>.
	/// </summary>
	[Parameter]
	public IEnumerable<PlannerTicket>? Tickets { get; set; }

	/// <summary>
	/// Callback triggered when a ticket drag operation starts from the ticket pool.
	/// </summary>
	[Parameter]
	public EventCallback<string> OnTicketDragStart { get; set; }

	string SearchText { get; set; } = string.Empty;
	string? SelectedType { get; set; }
	string? SelectedPriority { get; set; }

	List<PlannerTicket> _tickets = new();
	List<PlannerTicket> _allTicketsSnapshot = new();

	List<PlannerMember> _members = new();
	List<PlannerAssignment> _assignments = new();

	// Add member dialog state
	bool _showAddMember = false;

	private DotNetObjectReference<TicketPool>? _dotNetRef;

	IEnumerable<PlannerTicket> FilteredTickets => _tickets
			.Where(t => string.IsNullOrWhiteSpace(SearchText) || t.Title.Contains(SearchText, StringComparison.OrdinalIgnoreCase) || t.Key.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
			.Where(t => string.IsNullOrEmpty(SelectedType) || t.Type == SelectedType)
			.Where(t => string.IsNullOrEmpty(SelectedPriority) || t.Priority == SelectedPriority);

	IEnumerable<string> AvailableTypes => _tickets
					.Select(t => t.Type)
					.Where(t => !string.IsNullOrWhiteSpace(t))
					.Distinct();

	IEnumerable<string> AvailablePriorities => _tickets
					.Select(t => t.Priority)
					.Where(p => !string.IsNullOrWhiteSpace(p))
					.Distinct();

	/// <summary>
	/// Initializes component state and creates the .NET interop reference used by drag-and-drop JavaScript handlers.
	/// </summary>
	protected override async Task OnInitializedAsync()
	{
		_dotNetRef = DotNetObjectReference.Create(this);

		if (Tickets != null)
		{
			_tickets = Tickets.ToList();
			_allTicketsSnapshot = _tickets.Select(t => new PlannerTicket { Id = t.Id, Key = t.Key, Title = t.Title, Type = t.Type, Priority = t.Priority, Status = t.Status, EstimatedHours = t.EstimatedHours }).ToList();
		}
		else
		{
			var data = await TicketService.GetTicketsAsync();
			_tickets = data.ToList();
			// keep snapshot for assigned ticket lookup after removal from pool
			_allTicketsSnapshot = _tickets.Select(t => new PlannerTicket { Id = t.Id, Key = t.Key, Title = t.Title, Type = t.Type, Priority = t.Priority, Status = t.Status, EstimatedHours = t.EstimatedHours }).ToList();
		}

		// initial members
		_members = new List<PlannerMember>
				{
						new PlannerMember { Id = "m1", DisplayName = "Alex Kim", Role = "Frontend Dev", MonthlyCapacityHours = 40, Color = "#00D3A7" },
						new PlannerMember { Id = "m2", DisplayName = "Sara Müller", Role = "UX Designer", MonthlyCapacityHours = 40, Color = "#6B5CFF" },
						new PlannerMember { Id = "m3", DisplayName = "Jordan Lee", Role = "Backend Dev", MonthlyCapacityHours = 32, Color = "#FF5C7A" }
				};

		// saved state will be loaded after first render (JSInterop requires client connection)
	}

	/// <summary>
	/// Loads persisted planner state after first render, when JS interop is available.
	/// </summary>
	/// <param name="firstRender">Indicates whether this is the first render cycle.</param>
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await LoadStateAsync();
		}
	}

	/// <summary>
	/// Handles drop events coming from JavaScript for assigning or moving tickets between members.
	/// </summary>
	/// <param name="memberId">Target member receiving the ticket.</param>
	/// <param name="ticketId">Dropped ticket identifier.</param>
	/// <param name="sourceMemberId">Source member when moving an existing assignment.</param>
	[JSInvokable]
	public async Task OnDropFromJs(string memberId, string ticketId, string? sourceMemberId = null)
	{
		// If sourceMemberId provided, it's a move between lanes
		if (!string.IsNullOrEmpty(sourceMemberId) && sourceMemberId != memberId)
		{
			await HandleMoveAssignment(sourceMemberId, memberId, ticketId);
			await SaveStateAsync();
			return;
		}

		// Otherwise, it's a new assignment from pool
		var ticket = _allTicketsSnapshot.FirstOrDefault(t => t.Id == ticketId);
		if (ticket != null)
		{
			_assignments.Add(new PlannerAssignment { MemberId = memberId, TicketId = ticketId, PlannedHours = ticket.EstimatedHours });
			// remove from pool if present
			var inPool = _tickets.FirstOrDefault(t => t.Id == ticketId);
			if (inPool != null) _tickets.Remove(inPool);
			StateHasChanged();
			await SaveStateAsync();
		}
	}

	/// <summary>
	/// Returns all tickets currently assigned to the specified member.
	/// </summary>
	/// <param name="memberId">The member identifier.</param>
	/// <returns>Assigned tickets for the member.</returns>
	IEnumerable<PlannerTicket> GetAssignedTickets(string memberId)
	{
		var ids = _assignments.Where(a => a.MemberId == memberId).Select(a => a.TicketId).ToHashSet();
		return _allTicketsSnapshot.Where(t => ids.Contains(t.Id));
	}

	/// <summary>
	/// Removes a ticket assignment from a member and returns the ticket to the pool.
	/// </summary>
	/// <param name="memberId">The member identifier.</param>
	/// <param name="ticketId">The ticket identifier.</param>
	async Task HandleUnassign(string memberId, string ticketId)
	{
		// Remove assignment
		var assignment = _assignments.FirstOrDefault(a => a.MemberId == memberId && a.TicketId == ticketId);
		if (assignment != null)
		{
			_assignments.Remove(assignment);
		}
		// Add ticket back to pool
		var ticket = _allTicketsSnapshot.FirstOrDefault(t => t.Id == ticketId);
		if (ticket != null && !_tickets.Any(t => t.Id == ticketId))
		{
			_tickets.Add(ticket);
		}
		StateHasChanged();
		await SaveStateAsync();
	}

	/// <summary>
	/// Moves an assigned ticket from one member lane to another.
	/// </summary>
	/// <param name="sourceMemberId">The current assignee member identifier.</param>
	/// <param name="targetMemberId">The destination member identifier.</param>
	/// <param name="ticketId">The ticket identifier.</param>
	async Task HandleMoveAssignment(string sourceMemberId, string targetMemberId, string ticketId)
	{
		// Remove from source
		var sourceAssignment = _assignments.FirstOrDefault(a => a.MemberId == sourceMemberId && a.TicketId == ticketId);
		if (sourceAssignment != null)
		{
			_assignments.Remove(sourceAssignment);
		}
		// Add to target
		var ticket = _allTicketsSnapshot.FirstOrDefault(t => t.Id == ticketId);
		if (ticket != null)
		{
			_assignments.Add(new PlannerAssignment { MemberId = targetMemberId, TicketId = ticketId, PlannedHours = ticket.EstimatedHours });
		}
		StateHasChanged();
		await SaveStateAsync();
	}

	void Testclick()
	{
		Console.WriteLine("Test click");
	}

	/// <summary>
	/// Opens the add-member dialog.
	/// </summary>
	void ShowAddMember()
	{
		_showAddMember = true;
	}
	void HideAddMember() { _showAddMember = false; }

	/// <summary>
	/// Clears all ticket search and filter criteria.
	/// </summary>
	void ClearFilters()
	{
		SelectedType = null;
		SelectedPriority = null;
		SearchText = string.Empty;
	}

	/// <summary>
	/// Adds a new team member and registers the member lane as a drop zone.
	/// </summary>
	/// <param name="member">The member created from the add-member dialog.</param>
	async Task HandleDialogAddMember(PlannerMember member)
	{
		if (member == null || string.IsNullOrWhiteSpace(member.DisplayName)) return;
		var id = "m" + (_members.Count + 1).ToString();
		member.Id = id;
		_members.Add(member);
		_showAddMember = false;
		// ensure the new member markup is rendered before registering the drop zone
		await InvokeAsync(StateHasChanged);
		// small delay to allow DOM to update on the client
		await Task.Delay(50);
		if (_dotNetRef != null)
		{
			await JS.InvokeVoidAsync("ticketPlanner.registerDropZone", $"member-{member.Id}", _dotNetRef, member.Id);
		}
		// persist new member
		await SaveStateAsync();
	}

	decimal GetAssignedHours(string memberId) => _assignments.Where(a => a.MemberId == memberId).Sum(a => a.PlannedHours);

	int GetCapacityPercentInt(PlannerMember m)
	{
		if (m.MonthlyCapacityHours <= 0) return 0;
		var p = (double)(GetAssignedHours(m.Id) / m.MonthlyCapacityHours) * 100.0;
		if (p < 0) p = 0; if (p > 100) p = 100;
		return (int)Math.Round(p);
	}

	/// <summary>
	/// Releases unmanaged interop references created for JavaScript callbacks.
	/// </summary>
	/// <returns>A completed task value.</returns>
	public ValueTask DisposeAsync()
	{
		_dotNetRef?.Dispose();
		return ValueTask.CompletedTask;
	}

	string GetCapacityPercent(PlannerMember m) => GetCapacityPercentInt(m) + "%";

	string GetInitials(string name)
	{
		if (string.IsNullOrWhiteSpace(name)) return "";
		var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
		if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
		return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpperInvariant();
	}

	int GetTotalAssignedHours() => (int)_assignments.Sum(a => a.PlannedHours);

	string GetTypeClass(string type) => type.ToLowerInvariant() switch
	{
		"feature" => "type-feature",
		"bug" => "type-bug",
		"task" => "type-task",
		"spike" => "type-spike",
		_ => "type-default"
	};

	string GetPriorityClass(string p) => p.ToLowerInvariant() switch
	{
		"low" => "priority-low",
		"medium" => "priority-medium",
		"high" => "priority-high",
		"critical" => "priority-critical",
		_ => "priority-default"
	};

	/// <summary>
	/// Persists the current members and assignments using the configured storage service.
	/// </summary>
	async Task SaveStateAsync()
	{
		try
		{
			var plan = new PlannerPlan { Members = _members, Assignments = _assignments };
			await PlanStorage.SavePlanAsync(plan);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"SaveStateAsync error: {ex}");
		}
	}

	/// <summary>
	/// Loads a saved planner state and updates ticket pool availability accordingly.
	/// </summary>
	async Task LoadStateAsync()
	{
		try
		{
			var plan = await PlanStorage.LoadPlanAsync();
			if (plan == null) return;
			_members = plan.Members ?? new List<PlannerMember>();
			_assignments = plan.Assignments ?? new List<PlannerAssignment>();
			var assignedIds = _assignments.Select(a => a.TicketId).ToHashSet();
			_tickets = _allTicketsSnapshot.Where(t => !assignedIds.Contains(t.Id)).ToList();
			// register drop zones for restored members
			if (_dotNetRef != null)
			{
				foreach (var m in _members)
				{
					await JS.InvokeVoidAsync("ticketPlanner.registerDropZone", $"member-{m.Id}", _dotNetRef, m.Id);
				}
			}
			StateHasChanged();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"LoadStateAsync error: {ex}");
		}
	}

	/// <summary>
	/// Exports the current planner state as a JSON file.
	/// </summary>
	async Task ExportStateAsync()
	{
		try
		{
			var plan = new PlannerPlan { Members = _members, Assignments = _assignments };
			await PlanStorage.ExportPlanAsync(plan);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"ExportStateAsync error: {ex}");
		}
	}

	/// <summary>
	/// Imports planner state from an uploaded JSON file and refreshes member drop zones.
	/// </summary>
	/// <param name="e">The uploaded file event args.</param>
	async Task ImportFileAsync(FilesUploadingEventArgs e)
	{
		if (e.Files.Count == 0) return;
		var file = e.Files.FirstOrDefault();

		if (file == null) return;

		try
		{
			using var stream = file.OpenReadStream(10 * 1024 * 1024);
			using var sr = new System.IO.StreamReader(stream);
			var json = await sr.ReadToEndAsync();
			var jsonOptions = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
			var plan = JsonSerializer.Deserialize<PlannerPlan>(json, jsonOptions);
			if (plan == null) return;
			_members = plan.Members ?? new List<PlannerMember>();
			_assignments = plan.Assignments ?? new List<PlannerAssignment>();
			var assignedIds = _assignments.Select(a => a.TicketId).ToHashSet();
			_tickets = _allTicketsSnapshot.Where(t => !assignedIds.Contains(t.Id)).ToList();
			if (_dotNetRef != null)
			{
				foreach (var m in _members)
				{
					await JS.InvokeVoidAsync("ticketPlanner.registerDropZone", $"member-{m.Id}", _dotNetRef, m.Id);
				}
			}
			StateHasChanged();
			await SaveStateAsync();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"ImportFileAsync error: {ex}");
		}
	}
}
